{
  "name": "herio",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "EXPO_NO_TELEMETRY=1 expo start",
    "dev:lan": "EXPO_NO_TELEMETRY=1 expo start --lan",
    "dev:tunnel": "EXPO_NO_TELEMETRY=1 expo start --tunnel",
    "dev:android": "EXPO_NO_TELEMETRY=1 expo start --android",
    "dev:ios": "EXPO_NO_TELEMETRY=1 expo start --ios",
    "build:web": "expo export --platform web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "generate:play-assets": "node scripts/generate-google-play-assets.mjs",
    "version:patch": "node scripts/bump-version.mjs patch",
    "version:minor": "node scripts/bump-version.mjs minor",
    "version:major": "node scripts/bump-version.mjs major",
    "build:aab": "cd android && gradlew.bat bundleRelease"
  },
  "dependencies": {
    "@expo/cli": "^55.0.19",
    "@expo/vector-icons": "^15.0.2",
    "@lucide/lab": "^0.1.2",
    "@ptomasroos/react-native-multi-slider": "^2.2.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.6.0",
    "@react-native-community/slider": "5.1.2",
    "@react-native-ml-kit/face-detection": "^2.0.1",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "@supabase/supabase-js": "^2.58.0",
    "expo": "~55.0.11",
    "expo-blur": "~55.0.12",
    "expo-camera": "~55.0.13",
    "expo-clipboard": "~55.0.11",
    "expo-constants": "~55.0.9",
    "expo-dev-client": "~55.0.22",
    "expo-device": "~55.0.12",
    "expo-file-system": "~55.0.12",
    "expo-font": "~55.0.4",
    "expo-haptics": "~55.0.11",
    "expo-image-manipulator": "~55.0.21",
    "expo-image-picker": "~55.0.16",
    "expo-linear-gradient": "~55.0.11",
    "expo-linking": "~55.0.11",
    "expo-location": "~55.1.6",
    "expo-notifications": "~55.0.16",
    "expo-router": "~55.0.10",
    "expo-secure-store": "~55.0.11",
    "expo-speech": "~55.0.11",
    "expo-splash-screen": "~55.0.15",
    "expo-status-bar": "~55.0.5",
    "expo-symbols": "~55.0.7",
    "expo-system-ui": "~55.0.13",
    "expo-web-browser": "~55.0.12",
    "lucide-react-native": "^0.544.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.4",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.16.0",
    "react-native-worklets": "0.7.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.2.10",
    "eslint": "^9.39.4",
    "eslint-config-expo": "~55.0.0",
    "sharp": "^0.34.5",
    "supabase": "^2.78.1",
    "typescript": "~5.9.2"
  }
